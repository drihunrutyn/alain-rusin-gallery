# Единственный файл окружения — корневая .env. Не коммитьте реальные значения.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_LOGIN=
ADMIN_PASSWORD=
AUTH_SECRET=
WEBSITE_URL=
APPLICATION_ID=
# Public storefront. No secrets in these URLs.
PUBLIC_SITE_URL=https://drihunrutyn.github.io/alain-rusin-gallery
PAGES_BASE_PATH=/alain-rusin-gallery/
ADMIN_SITE_URL=https://alain-rusin.onrender.com
# Local migration only; never add this write credential to Pages Actions.
DATABASE_MIGRATION_AUTH_TOKEN=
# Server-only PAT, repository Contents: write. Never VITE-prefixed.
UPLOAD_GITHUB_TOKEN=
